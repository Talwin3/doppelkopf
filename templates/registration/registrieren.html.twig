{% extends 'base.html.twig' %}

{% block title %}Registrieren – Doppelkopf Online{% endblock %}

{% block body %}
<div class="flex min-h-[60vh] items-center justify-center">
    <div class="w-full max-w-md">
        <h1 class="text-2xl font-bold text-gray-900 text-center mb-8">Konto erstellen</h1>

        {{ form_start(formular, {attr: {class: 'space-y-5'}}) }}

            {% for fehler in formular.vars.errors %}
                <div class="flash-error">{{ fehler.message }}</div>
            {% endfor %}

            <div>
                {{ form_label(formular.username, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(formular.username, {attr: {class: 'form-input'}}) }}
                {{ form_errors(formular.username) }}
            </div>

            <div>
                {{ form_label(formular.email, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(formular.email, {attr: {class: 'form-input'}}) }}
                {{ form_errors(formular.email) }}
                <p class="mt-1 text-xs text-gray-500">Wird niemals öffentlich angezeigt.</p>
            </div>

            <div>
                {{ form_label(formular.plainPassword.first, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(formular.plainPassword.first, {attr: {class: 'form-input'}}) }}
                {{ form_errors(formular.plainPassword.first) }}
            </div>

            <div>
                {{ form_label(formular.plainPassword.second, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(formular.plainPassword.second, {attr: {class: 'form-input'}}) }}
                {{ form_errors(formular.plainPassword.second) }}
            </div>

            <div class="flex items-start space-x-3">
                {{ form_widget(formular.datenschutzAkzeptiert, {attr: {class: 'mt-0.5 rounded border-gray-300 text-tisch-600'}}) }}
                <div class="text-sm text-gray-600">
                    Ich habe die
                    <a href="{{ path('app_datenschutz') }}" target="_blank" class="text-tisch-700 underline">Datenschutzerklärung</a>
                    gelesen und akzeptiere sie.
                </div>
            </div>
            {{ form_errors(formular.datenschutzAkzeptiert) }}

            <button type="submit" class="btn-primary w-full justify-center py-2.5">
                Konto erstellen
            </button>

        {{ form_end(formular) }}

        <p class="mt-6 text-center text-sm text-gray-500">
            Bereits registriert?
            <a href="{{ path('app_login') }}" class="text-tisch-700 font-medium hover:text-tisch-900">
                Jetzt anmelden
            </a>
        </p>
    </div>
</div>
{% endblock %}
