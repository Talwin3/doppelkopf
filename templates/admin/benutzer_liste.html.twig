{% extends 'base.html.twig' %}

{% block title %}Benutzerverwaltung – Admin{% endblock %}

{% block body %}
<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Benutzerverwaltung</h1>
    <a href="{{ path('app_admin') }}" class="btn-secondary text-sm">← Dashboard</a>
</div>

<div class="bg-white dark:bg-gray-800 shadow rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-900">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Benutzername</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Verifiziert</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Admin</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Registriert</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Aktionen</th>
            </tr>
        </thead>
        <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
            {% for user in benutzer %}
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-gray-100">
                    {{ user.username }}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                    {% if user.verified %}
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300">Ja</span>
                    {% else %}
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800 dark:bg-yellow-900/40 dark:text-yellow-300">Nein</span>
                    {% endif %}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                    {% if 'ROLE_ADMIN' in user.roles %}
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800 dark:bg-purple-900/40 dark:text-purple-300">Admin</span>
                    {% else %}
                        <span class="text-gray-400 dark:text-gray-500">–</span>
                    {% endif %}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
                    {{ user.erstelltAm|date('d.m.Y H:i') }}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                    {% if user != app.user %}
                        <form method="post" action="{{ path('app_admin_benutzer_admin_toggle', {id: user.id}) }}" class="inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_toggle_' ~ user.id) }}">
                            <button type="submit" class="text-tisch-700 dark:text-tisch-400 hover:text-tisch-900 dark:hover:text-tisch-300 text-xs font-medium">
                                {% if 'ROLE_ADMIN' in user.roles %}Admin entziehen{% else %}Zum Admin machen{% endif %}
                            </button>
                        </form>
                    {% else %}
                        <span class="text-gray-300 dark:text-gray-600 text-xs">(du)</span>
                    {% endif %}
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="5" class="px-6 py-8 text-center text-sm text-gray-400 dark:text-gray-500">Keine Benutzer vorhanden.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
