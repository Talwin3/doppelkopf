{% extends 'base.html.twig' %}

{% block title %}Admin – Doppelkopf Online{% endblock %}

{% block body %}
<div class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900">Admin-Dashboard</h1>
</div>

<div class="grid grid-cols-1 gap-5 sm:grid-cols-3 mb-10">
    <div class="bg-white overflow-hidden shadow rounded-lg px-6 py-5">
        <p class="text-sm font-medium text-gray-500">Registrierte Benutzer</p>
        <p class="mt-1 text-3xl font-bold text-gray-900">{{ gesamtBenutzer }}</p>
    </div>
    <div class="bg-white overflow-hidden shadow rounded-lg px-6 py-5">
        <p class="text-sm font-medium text-gray-500">Verifizierte Benutzer</p>
        <p class="mt-1 text-3xl font-bold text-tisch-700">{{ verifiziert }}</p>
    </div>
    <div class="bg-white overflow-hidden shadow rounded-lg px-6 py-5">
        <p class="text-sm font-medium text-gray-500">Aktive Tische</p>
        <p class="mt-1 text-3xl font-bold text-gray-900">—</p>
        <p class="text-xs text-gray-400 mt-1">verfügbar ab Phase 1</p>
    </div>
</div>

<div class="flex gap-4">
    <a href="{{ path('app_admin_benutzer') }}" class="btn-primary">Benutzerverwaltung</a>
    <a href="{{ path('app_admin_einstellungen') }}" class="btn-secondary">Systemeinstellungen</a>
</div>
{% endblock %}
