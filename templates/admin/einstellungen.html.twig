{% extends 'base.html.twig' %}

{% block title %}Systemeinstellungen – Admin{% endblock %}

{% block body %}
<div class="mb-8">
    <div class="flex items-center gap-4">
        <a href="{{ path('app_admin') }}" class="text-gray-500 hover:text-gray-700 text-sm">← Dashboard</a>
        <h1 class="text-2xl font-bold text-gray-900">Systemeinstellungen</h1>
    </div>
    <p class="mt-1 text-sm text-gray-500">Änderungen wirken nach max. 60 Sekunden (Cache-TTL).</p>
</div>

{% for flash in app.flashes('success') %}
    <div class="mb-4 rounded bg-green-50 border border-green-200 px-4 py-3 text-green-800 text-sm">{{ flash }}</div>
{% endfor %}
{% for flash in app.flashes('error') %}
    <div class="mb-4 rounded bg-red-50 border border-red-200 px-4 py-3 text-red-800 text-sm">{{ flash }}</div>
{% endfor %}

<div class="bg-white shadow rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Schlüssel</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Wert</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Beschreibung</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Zuletzt geändert</th>
                <th class="px-6 py-3"></th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            {% for einstellung in einstellungen %}
            <tr>
                <td class="px-6 py-4 text-sm font-mono text-gray-900">{{ einstellung.schluessel }}</td>
                <td class="px-6 py-4">
                    <form method="post" action="{{ path('app_admin_einstellung_speichern', {schluessel: einstellung.schluessel}) }}" class="flex items-center gap-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('einstellung_' ~ einstellung.schluessel) }}">
                        <input type="text"
                               name="wert"
                               value="{{ einstellung.wert }}"
                               class="border border-gray-300 rounded px-2 py-1 text-sm w-24 focus:ring-1 focus:ring-tisch-500 focus:border-tisch-500">
                        <button type="submit" class="text-xs bg-tisch-600 text-white px-3 py-1.5 rounded hover:bg-tisch-700">Speichern</button>
                    </form>
                </td>
                <td class="px-6 py-4 text-sm text-gray-500">{{ einstellung.beschreibung ?? '—' }}</td>
                <td class="px-6 py-4 text-sm text-gray-400">{{ einstellung.aktualisiertAm|date('d.m.Y H:i') }}</td>
            </tr>
            {% else %}
            <tr>
                <td colspan="4" class="px-6 py-4 text-sm text-gray-400 text-center">Keine Einstellungen vorhanden. Führe <code>bin/console app:system:init</code> aus.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
