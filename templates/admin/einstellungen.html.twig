{% extends 'base.html.twig' %}

{% block title %}Systemeinstellungen – Admin{% endblock %}

{% block body %}
<div class="mb-8">
    <div class="flex items-center gap-4">
        <a href="{{ path('app_admin') }}" class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 text-sm">← Dashboard</a>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Systemeinstellungen</h1>
    </div>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Änderungen wirken nach max. 60 Sekunden (Cache-TTL).</p>
</div>

{% for flash in app.flashes('success') %}
    <div class="mb-4 rounded bg-green-50 dark:bg-green-950/50 border border-green-200 dark:border-green-800 px-4 py-3 text-green-800 dark:text-green-300 text-sm">{{ flash }}</div>
{% endfor %}
{% for flash in app.flashes('error') %}
    <div class="mb-4 rounded bg-red-50 dark:bg-red-950/50 border border-red-200 dark:border-red-800 px-4 py-3 text-red-800 dark:text-red-300 text-sm">{{ flash }}</div>
{% endfor %}

<div class="bg-white dark:bg-gray-800 shadow rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-900">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Schlüssel</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Wert</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Beschreibung</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Zuletzt geändert</th>
                <th class="px-6 py-3"></th>
            </tr>
        </thead>
        <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
            {% for einstellung in einstellungen %}
            <tr>
                <td class="px-6 py-4 text-sm font-mono text-gray-900 dark:text-gray-100">{{ einstellung.schluessel }}</td>
                <td class="px-6 py-4">
                    <form method="post" action="{{ path('app_admin_einstellung_speichern', {schluessel: einstellung.schluessel}) }}" class="flex items-center gap-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('einstellung_' ~ einstellung.schluessel) }}">
                        {% if einstellung.schluessel == 'bot_avatar_stil' %}
                            <img src="{{ avatar_url_roh(einstellung.wert, 'Hans', 64) }}" alt="Vorschau"
                                 class="w-10 h-10 rounded-full bg-gray-100 dark:bg-gray-700 shrink-0">
                            <select name="wert"
                                    class="border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded px-2 py-1 text-sm focus:ring-1 focus:ring-tisch-500 focus:border-tisch-500">
                                {% for stil in avatarStile %}
                                    <option value="{{ stil.value }}" {{ einstellung.wert == stil.value ? 'selected' : '' }}>{{ stil.label }}</option>
                                {% endfor %}
                            </select>
                        {% else %}
                            <input type="text"
                                   name="wert"
                                   value="{{ einstellung.wert }}"
                                   class="border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded px-2 py-1 text-sm w-24 focus:ring-1 focus:ring-tisch-500 focus:border-tisch-500">
                        {% endif %}
                        <button type="submit" class="text-xs bg-tisch-600 text-white px-3 py-1.5 rounded hover:bg-tisch-700">Speichern</button>
                    </form>
                </td>
                <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">{{ einstellung.beschreibung ?? '—' }}</td>
                <td class="px-6 py-4 text-sm text-gray-400 dark:text-gray-500">{{ einstellung.aktualisiertAm|date('d.m.Y H:i') }}</td>
            </tr>
            {% else %}
            <tr>
                <td colspan="4" class="px-6 py-4 text-sm text-gray-400 dark:text-gray-500 text-center">Keine Einstellungen vorhanden. Führe <code>bin/console app:system:init</code> aus.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
