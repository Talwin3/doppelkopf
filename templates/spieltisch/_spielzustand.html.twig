{% if spiel is null %}
    <div class="text-center py-16 text-gray-400">
        <p class="text-xl font-medium">Warte auf Spieler…</p>
        <p class="text-sm mt-2">{{ tisch.aktiveSpieler.count }}/4 Spieler am Tisch</p>
    </div>

{% elseif spiel.status.value == 'BEENDET' %}
    <div class="text-center py-12">
        <h2 class="text-2xl font-bold text-white mb-6">Spiel beendet!</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-lg mx-auto">
            {% for t in spiel.teilnehmer %}
                <div class="bg-white rounded-xl p-4 text-center shadow">
                    <p class="font-bold text-gray-900 text-sm truncate">{{ t.user ? t.user.username : 'Bot' }}</p>
                    <p class="text-xs mt-1 {{ t.team and t.team.value == 'RE' ? 'text-blue-600' : 'text-red-600' }}">{{ t.team ? t.team.value : '?' }}</p>
                    <p class="text-2xl font-bold mt-2 {{ t.gewonnen ? 'text-green-600' : 'text-gray-400' }}">
                        {{ t.punkteDelta > 0 ? '+' : '' }}{{ t.punkteDelta }}
                    </p>
                </div>
            {% endfor %}
        </div>
        <a href="{{ path('app_lobby') }}" class="btn-primary mt-8 inline-block">Zurück zur Lobby</a>
    </div>

{% elseif spiel.status.value == 'VORBEHALT' %}
    {# ── Vorbehaltsrunde ──────────────────────────────────────────────── #}
    {% set meinSitzplatz = teilnehmer ? teilnehmer.sitzplatz : 0 %}
    {% set ichBinDran = spiel.aktuellerSpielerSitzplatz == meinSitzplatz %}

    <div class="flex flex-col items-center justify-center py-8 gap-6">
        <div class="text-center">
            <h2 class="text-xl font-bold text-white mb-1">Vorbehaltsrunde</h2>
            <p class="text-tisch-300 text-sm">Jeder Spieler deklariert reihum seinen Vorbehalt.</p>
        </div>

        {# Status der Deklarationen #}
        <div class="flex gap-4">
            {% for t in spiel.teilnehmer|sort((a, b) => a.sitzplatz <=> b.sitzplatz) %}
                <div class="text-center">
                    <div class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold
                        {% if t.vorbehaltDeklariert %}bg-green-600 text-white{% elseif spiel.aktuellerSpielerSitzplatz == t.sitzplatz %}bg-yellow-400 text-black animate-pulse{% else %}bg-tisch-700 text-tisch-400{% endif %}">
                        {{ t.vorbehaltDeklariert ? '✓' : (spiel.aktuellerSpielerSitzplatz == t.sitzplatz ? '?' : '…') }}
                    </div>
                    <p class="text-xs text-tisch-300 mt-1 truncate max-w-16">{{ t.user ? t.user.username : 'Bot' }}</p>
                    {% if t.vorbehaltDeklariert and t.sitzplatz == meinSitzplatz %}
                        <p class="text-xs text-green-400 mt-0.5">{{ t.vorbehaltTyp ? t.vorbehaltTyp.value : '' }}</p>
                    {% endif %}
                </div>
            {% endfor %}
        </div>

        {# Eigene Deklaration — nur wenn ich an der Reihe #}
        {% if ichBinDran and teilnehmer and not teilnehmer.vorbehaltDeklariert %}
            <div class="bg-tisch-800 rounded-xl p-5 border border-tisch-600 w-full max-w-sm">
                <p class="text-white text-sm font-medium mb-3 text-center">Du bist an der Reihe:</p>
                <div class="flex flex-col gap-2">
                    {# GESUND #}
                    {% if 'GESUND' in vorbehaltOptionen|map(o => o.value) %}
                        <form method="post" action="{{ path('app_vorbehalt', {id: tisch.id}) }}"
                              data-action="submit->spieltisch#vorbehalt">
                            <input type="hidden" name="_token" value="{{ csrf_token('vorbehalt_' ~ tisch.id) }}">
                            <input type="hidden" name="vorbehalt_typ" value="GESUND">
                            <button type="submit" class="w-full py-2 rounded-lg bg-tisch-600 hover:bg-tisch-500 text-white text-sm font-medium">
                                Gesund (kein Vorbehalt)
                            </button>
                        </form>
                    {% endif %}

                    {# HOCHZEIT #}
                    {% if 'HOCHZEIT' in vorbehaltOptionen|map(o => o.value) %}
                        <form method="post" action="{{ path('app_vorbehalt', {id: tisch.id}) }}"
                              data-action="submit->spieltisch#vorbehalt">
                            <input type="hidden" name="_token" value="{{ csrf_token('vorbehalt_' ~ tisch.id) }}">
                            <input type="hidden" name="vorbehalt_typ" value="HOCHZEIT">
                            <button type="submit" class="w-full py-2 rounded-lg bg-purple-700 hover:bg-purple-600 text-white text-sm font-medium">
                                Hochzeit ♛♛
                            </button>
                        </form>
                    {% endif %}

                    {# SOLO — mit Variantenauswahl #}
                    {% if 'SOLO' in vorbehaltOptionen|map(o => o.value) %}
                        <details class="rounded-lg bg-yellow-900 border border-yellow-700">
                            <summary class="w-full py-2 px-4 text-yellow-300 text-sm font-medium cursor-pointer">
                                Solo spielen ▼
                            </summary>
                            <div class="p-3 grid grid-cols-2 gap-2">
                                {% set soloVarianten = ['SOLO_BUBEN', 'SOLO_DAMEN', 'SOLO_FLEISCHLOS', 'SOLO_KARO', 'SOLO_HERZ', 'SOLO_PIK', 'SOLO_KREUZ'] %}
                                {% set regelwerk = tisch.regelEinstellungen %}
                                {% for variante in soloVarianten %}
                                    {% if variante in (regelwerk.soli_erlaubt ?? soloVarianten) %}
                                        <form method="post" action="{{ path('app_vorbehalt', {id: tisch.id}) }}"
                                              data-action="submit->spieltisch#vorbehalt">
                                            <input type="hidden" name="_token" value="{{ csrf_token('vorbehalt_' ~ tisch.id) }}">
                                            <input type="hidden" name="vorbehalt_typ" value="SOLO">
                                            <input type="hidden" name="solo_variante" value="{{ variante }}">
                                            <button type="submit" class="w-full py-1.5 rounded bg-yellow-700 hover:bg-yellow-600 text-yellow-100 text-xs font-medium">
                                                {{ variante|replace({'SOLO_': '', '_': '-'}) }}
                                            </button>
                                        </form>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </details>
                    {% endif %}
                </div>
            </div>
        {% elseif teilnehmer and teilnehmer.vorbehaltDeklariert %}
            <div class="bg-green-900 border border-green-700 rounded-lg px-6 py-3 text-green-300 text-sm text-center">
                Du hast <strong>{{ teilnehmer.vorbehaltTyp ? teilnehmer.vorbehaltTyp.value : '' }}</strong> deklariert.
                Warte auf die anderen Spieler…
            </div>
        {% else %}
            <div class="text-tisch-400 text-sm text-center">
                Warte auf Sitzplatz {{ spiel.aktuellerSpielerSitzplatz }}…
            </div>
        {% endif %}

        {# Karten-Vorschau (nicht spielbar in Vorbehaltsrunde) #}
        {% if hand is not empty %}
            <div class="flex flex-wrap gap-2 justify-center opacity-75">
                {% for karte in hand %}
                    <div class="spielkarte spielkarte--gross {{ karte.farbe.istRot() ? 'spielkarte--rot' : 'spielkarte--schwarz' }}">
                        <span class="spielkarte__symbol">{{ karte.farbe.symbol() }}</span>
                        <span class="spielkarte__wert">{{ karte.wert.anzeige() }}</span>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

{% else %}
    {# Teilnehmer nach Sitzplatz indexieren #}
    {% set meinSitzplatz = teilnehmer ? teilnehmer.sitzplatz : 0 %}
    {% set teilnehmerMap = {} %}
    {% for t in spiel.teilnehmer %}
        {% set teilnehmerMap = teilnehmerMap|merge({(t.sitzplatz): t}) %}
    {% endfor %}

    {% set linkerSitz  = (meinSitzplatz % 4) + 1 %}
    {% set obererSitz  = (linkerSitz % 4) + 1 %}
    {% set rechterSitz = (obererSitz % 4) + 1 %}

    {% set stichKarten = spiel.aktuelleStichKarten %}

    {# Ansagen pro Sitzplatz indexieren (für Gegner-Anzeige) #}
    {% set ansagenBySitzplatz = {} %}
    {% for a in ansagen %}
        {% set bisherige = ansagenBySitzplatz[a.sitzplatz] ?? [] %}
        {% set ansagenBySitzplatz = ansagenBySitzplatz|merge({(a.sitzplatz): bisherige|merge([a.ansageTyp.value])}) %}
    {% endfor %}

    <div class="flex flex-col h-full gap-2">

        {# ── Oberer Spieler ─────────────────────────────────────────────── #}
        <div class="flex justify-center">
            {% include 'spieltisch/_gegner_strip.html.twig' with {
                teilnehmer: teilnehmerMap[obererSitz] ?? null,
                istDran: spiel.aktuellerSpielerSitzplatz == obererSitz,
                anzahlKarten: 12 - (stichKarten|filter(k => k.sitzplatz == obererSitz)|length),
                ansagen: ansagenBySitzplatz[obererSitz] ?? []
            } %}
        </div>

        {# ── Mittlere Reihe ──────────────────────────────────────────────── #}
        <div class="flex flex-1 items-center gap-4">

            <div class="flex-none w-28">
                {% include 'spieltisch/_gegner_strip.html.twig' with {
                    teilnehmer: teilnehmerMap[linkerSitz] ?? null,
                    istDran: spiel.aktuellerSpielerSitzplatz == linkerSitz,
                    anzahlKarten: 12 - (stichKarten|filter(k => k.sitzplatz == linkerSitz)|length),
                    ansagen: ansagenBySitzplatz[linkerSitz] ?? [],
                    vertikal: true
                } %}
            </div>

            {# ── Tisch-Mitte: Stich + aktive Ansagen ────────────────────── #}
            <div class="flex-1 min-h-40 bg-tisch-800 rounded-2xl border-4 border-tisch-600 shadow-inner flex flex-col items-center justify-center gap-3 p-4">

                {# Aktive Ansagen-Badges #}
                {% if ansagen is not empty %}
                    <div class="flex flex-wrap gap-1 justify-center">
                        {% set angezeigt = [] %}
                        {% for a in ansagen %}
                            {% if a.ansageTyp.value not in angezeigt %}
                                {% set angezeigt = angezeigt|merge([a.ansageTyp.value]) %}
                                {% set istRe = a.ansageTyp.value == 'RE' %}
                                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-bold
                                    {{ istRe ? 'bg-blue-600 text-white' : 'bg-red-600 text-white' }}">
                                    {{ a.ansageTyp.value|replace({'_': ' '}) }}
                                </span>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}

                {# Stichkarten #}
                {% if stichKarten is not empty %}
                    <div class="flex gap-3">
                        {% for gk in stichKarten %}
                            {% set karte = gk.alsKarte() %}
                            <div class="spielkarte spielkarte--mittel {{ karte.farbe.istRot() ? 'spielkarte--rot' : 'spielkarte--schwarz' }}">
                                <span class="spielkarte__symbol">{{ karte.farbe.symbol() }}</span>
                                <span class="spielkarte__wert">{{ karte.wert.anzeige() }}</span>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-tisch-300 text-sm">Warte auf ersten Zug…</p>
                {% endif %}

                {% set maxStiche = tisch.regelEinstellung('ohne_neuner') ? 10 : 12 %}
                <p class="text-tisch-200 text-xs">Stich {{ spiel.aktuellerStichNr }}/{{ maxStiche }}</p>
                {% if tisch.regelEinstellung('schweinchen') %}
                    <p class="text-yellow-400 text-xs font-medium">
                        {{ tisch.regelEinstellung('superschweinchen') ? 'Super-Schweinchen aktiv' : 'Schweinchen aktiv' }}
                    </p>
                {% endif %}
            </div>

            <div class="flex-none w-28">
                {% include 'spieltisch/_gegner_strip.html.twig' with {
                    teilnehmer: teilnehmerMap[rechterSitz] ?? null,
                    istDran: spiel.aktuellerSpielerSitzplatz == rechterSitz,
                    anzahlKarten: 12 - (stichKarten|filter(k => k.sitzplatz == rechterSitz)|length),
                    ansagen: ansagenBySitzplatz[rechterSitz] ?? [],
                    vertikal: true
                } %}
            </div>
        </div>

        {# ── Eigener Bereich: Ansage-Buttons + Karten ───────────────────── #}
        <div class="mt-2 space-y-2">
            {% set ichBinDran = spiel.aktuellerSpielerSitzplatz == meinSitzplatz %}
            {% set meinTeam   = teilnehmer ? teilnehmer.team : null %}

            {# Kopfzeile: Team-Badge, Dran-Anzeige #}
            <div class="flex items-center justify-between px-1">
                <span class="text-white text-sm font-medium flex items-center gap-2">
                    {% if meinTeam %}
                        <span class="px-2 py-0.5 rounded text-xs font-bold {{ meinTeam.value == 'RE' ? 'bg-blue-500' : 'bg-red-500' }} text-white">
                            {{ meinTeam.value }}
                        </span>
                    {% endif %}
                    Deine Karten ({{ hand|length }})
                    {# Eigene aktive Ansagen anzeigen #}
                    {% for typWert in ansagenBySitzplatz[meinSitzplatz] ?? [] %}
                        <span class="px-2 py-0.5 rounded text-xs font-bold bg-yellow-500 text-black">
                            {{ typWert|replace({'_': ' '}) }}!
                        </span>
                    {% endfor %}
                </span>
                {% if ichBinDran %}
                    <span class="text-yellow-300 text-xs font-bold animate-pulse">► Du bist dran!</span>
                {% endif %}
            </div>

            {# Ansage-Buttons #}
            {% if verfuegbareAnsagen is not empty %}
                <div class="flex flex-wrap gap-2 px-1">
                    {% for ansageTyp in verfuegbareAnsagen %}
                        {% set istReTyp = ansageTyp.value == 'RE' %}
                        <form method="post"
                              action="{{ path('app_ansagen', {id: tisch.id}) }}"
                              data-action="submit->spieltisch#ansagen">
                            <input type="hidden" name="_token" value="{{ csrf_token('ansagen_' ~ tisch.id) }}">
                            <input type="hidden" name="ansage_typ" value="{{ ansageTyp.value }}">
                            <button type="submit"
                                    class="rounded-full px-3 py-1 text-xs font-bold border-2 transition-all
                                        {{ istReTyp
                                            ? 'border-blue-400 text-blue-300 hover:bg-blue-800'
                                            : 'border-red-400 text-red-300 hover:bg-red-900' }}">
                                {{ ansageTyp.value|replace({'_': ' '}) }}!
                            </button>
                        </form>
                    {% endfor %}
                </div>
            {% endif %}

            {# Eigene Karten #}
            <div class="flex flex-wrap gap-2 justify-center">
                {% for karte in hand %}
                    {% if ichBinDran %}
                        <form method="post"
                              action="{{ path('app_karte_spielen', {id: tisch.id}) }}"
                              data-action="submit->spieltisch#karteAusspielen">
                            <input type="hidden" name="_token" value="{{ csrf_token('karte_spielen_' ~ tisch.id) }}">
                            <input type="hidden" name="karte_id" value="{{ karte.id() }}">
                            <button type="submit"
                                    class="spielkarte spielkarte--gross {{ karte.farbe.istRot() ? 'spielkarte--rot' : 'spielkarte--schwarz' }} spielkarte--spielbar"
                                    title="{{ karte.farbe.value }} {{ karte.wert.value }}">
                                <span class="spielkarte__symbol">{{ karte.farbe.symbol() }}</span>
                                <span class="spielkarte__wert">{{ karte.wert.anzeige() }}</span>
                            </button>
                        </form>
                    {% else %}
                        <div class="spielkarte spielkarte--gross {{ karte.farbe.istRot() ? 'spielkarte--rot' : 'spielkarte--schwarz' }}">
                            <span class="spielkarte__symbol">{{ karte.farbe.symbol() }}</span>
                            <span class="spielkarte__wert">{{ karte.wert.anzeige() }}</span>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>

    </div>
{% endif %}
