{# AJAX-Antwort der Route app_spieltisch_zustand. Der spieltisch-Controller
   verteilt die drei Sektionen: die Tisch-Kulisse ersetzt #zustand, die Dialog-
   Inhalte werden in die persistenten Overlay-Dialoge (#vorbehaltInhalt /
   #abrechnungInhalt) gespiegelt, ohne die <dialog>-Elemente selbst zu zerstören.
   data-phase steuert das Öffnen/Schließen der Dialoge. #}
{% set phase = spiel ? spiel.status.value : 'WARTEN' %}
<div data-zustand-root data-phase="{{ phase }}">
    <template data-bereich="tisch">{% include 'spieltisch/_tisch_bereich.html.twig' %}</template>
    <template data-bereich="vorbehalt">{% if phase == 'VORBEHALT' %}{% include 'spieltisch/_vorbehalt_inhalt.html.twig' %}{% endif %}</template>
    <template data-bereich="abrechnung">{% if letztesSpiel %}{% include 'spieltisch/_abrechnung_inhalt.html.twig' %}{% endif %}</template>
</div>
