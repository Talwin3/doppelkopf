{# Tisch-Chat – live via Mercure (chat_controller.js), tischgebunden #}
<section class="mt-4 bg-tisch-800/60 rounded-xl border border-tisch-700"
         data-controller="chat"
         data-chat-mercure-url-value="{{ mercureTopic ? mercurePublicUrl : '' }}"
         data-chat-topic-value="{{ mercureTopic ?: '' }}"
         data-chat-send-url-value="{{ path('app_chat_senden', {id: tisch.id}) }}"
         data-chat-csrf-value="{{ csrf_token('chat_' ~ tisch.id) }}"
         data-chat-mein-user-id-value="{{ meinUserId }}"
         data-chat-emoji-map-value="{{ emoji_map_json() }}">

    <button type="button"
            class="w-full flex items-center justify-between px-4 py-2 text-tisch-200 hover:text-white text-sm font-medium"
            data-action="chat#umschalten">
        <span>💬 Chat</span>
        <span class="text-xs text-tisch-400" data-chat-target="toggleIcon">▾</span>
    </button>

    <div data-chat-target="body" class="px-3 pb-3">
        <div data-chat-target="messages"
             class="h-48 overflow-y-auto space-y-1.5 rounded-lg bg-tisch-900/60 p-3 text-sm">
            {% for n in chatVerlauf %}
                {% if n.istSystem %}
                    <div class="flex justify-center">
                        <p class="max-w-[90%] text-center text-[11px] italic text-tisch-400 leading-snug px-2 py-0.5">
                            <span class="break-words">{{ n.text }}</span>
                            <span class="text-tisch-500 not-italic">· {{ n.erstelltAm|date('H:i') }}</span>
                        </p>
                    </div>
                {% else %}
                    {% set eigen = meinUserId != '' and n.absender and (n.absender.id ~ '') == meinUserId %}
                    <div class="flex flex-col {{ eigen ? 'items-end' : 'items-start' }}">
                        <div class="max-w-[85%] rounded-lg px-2.5 py-1.5 {{ eigen ? 'bg-tisch-600 text-white' : 'bg-tisch-700 text-tisch-100' }}">
                            {% if not eigen %}
                                <p class="text-[11px] font-semibold text-tisch-300 leading-tight">{{ n.absenderName }}</p>
                            {% endif %}
                            <p class="whitespace-pre-wrap break-words leading-snug">{{ n.text|emoji }}</p>
                            <p class="text-[10px] text-tisch-400 text-right leading-none mt-0.5">{{ n.erstelltAm|date('H:i') }}</p>
                        </div>
                    </div>
                {% endif %}
            {% else %}
                <p class="text-tisch-400 text-xs text-center py-4" data-chat-target="leer">
                    Noch keine Nachrichten. Schreib etwas!
                </p>
            {% endfor %}
        </div>

        {% if chatPhrasen is not empty %}
            <div class="flex flex-wrap gap-1.5 mt-2">
                {% for p in chatPhrasen %}
                    <button type="button"
                            data-action="chat#einfuegen"
                            data-chat-phrase-param="{{ p }}"
                            class="rounded-full bg-tisch-700 hover:bg-tisch-600 text-tisch-100 text-xs px-2.5 py-1 leading-none transition-colors">
                        {{ p }}
                    </button>
                {% endfor %}
            </div>
        {% endif %}

        <div class="relative">
            <div data-chat-target="emojiPanel"
                 class="hidden absolute bottom-full right-0 mb-2 z-10 w-64 rounded-lg bg-tisch-800 border border-tisch-600 shadow-lg p-2 grid grid-cols-8 gap-1">
                {% for e in emoji_katalog() %}
                    <button type="button"
                            data-action="chat#emojiEinfuegen"
                            data-chat-emoji-param="{{ e.unicode }}"
                            title="{{ e.name }}"
                            class="rounded p-1 hover:bg-tisch-700 transition-colors">
                        <img src="{{ e.url }}" alt="{{ e.name }}" class="w-6 h-6 block" draggable="false">
                    </button>
                {% endfor %}
            </div>

            <form class="flex gap-2 mt-2" data-action="submit->chat#senden">
                <input type="text" name="text" maxlength="500" autocomplete="off"
                       placeholder="Nachricht…"
                       data-chat-target="input"
                       class="flex-1 rounded-lg bg-tisch-900 border border-tisch-600 text-white text-sm px-3 py-1.5 placeholder-tisch-500 focus:outline-none focus:ring-2 focus:ring-tisch-500">
                <button type="button"
                        data-action="chat#pickerUmschalten"
                        aria-label="Emoji einfügen"
                        class="rounded-lg bg-tisch-700 hover:bg-tisch-600 text-white text-base px-3 leading-none">
                    😊
                </button>
                <button type="submit" class="rounded-lg bg-tisch-600 hover:bg-tisch-500 text-white text-sm font-medium px-4">
                    Senden
                </button>
            </form>
        </div>
    </div>
</section>
