{% extends 'base.html.twig' %}

{% block title %}Spieltisch: {{ tisch.name }} – Doppelkopf Online{% endblock %}

{% block body %}
{% set meinSitzplatz = 0 %}
{% for ts in tisch.aktiveSpieler %}
    {% if ts.user and ts.user.id == app.user.id %}
        {% set meinSitzplatz = ts.sitzplatz %}
    {% endif %}
{% endfor %}
{% set phase = spiel ? spiel.status.value : 'WARTEN' %}
<div class="bg-tisch-900 rounded-2xl shadow-2xl min-h-[calc(100vh-12rem)] p-4 flex flex-col"
     data-controller="spieltisch"
     data-spieltisch-mercure-url-value="{{ mercureTopic ? mercurePublicUrl : '' }}"
     data-spieltisch-topic-value="{{ mercureTopic ?: '' }}"
     data-spieltisch-zustand-url-value="{{ path('app_spieltisch_zustand', {id: tisch.id}) }}"
     data-spieltisch-mein-sitzplatz-value="{{ meinSitzplatz }}"
     data-spieltisch-phase-value="{{ phase }}">

    {# ── Kopfzeile ───────────────────────────────────────────────────── #}
    <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-3">
            <a href="{{ path('app_lobby') }}" class="text-tisch-300 hover:text-white text-sm transition-colors">
                ← Lobby
            </a>
            <span class="text-tisch-400">|</span>
            <h1 class="text-white font-bold text-lg">{{ tisch.name }}</h1>
            {% if spiel %}
                <span class="text-tisch-300 text-sm">
                    {% if spiel.status.value == 'VORBEHALT' %}
                        Vorbehaltsrunde…
                    {% elseif spiel.variante %}
                        {{ spiel.variante.value|replace({'_': ' '}) }}
                    {% endif %}
                </span>
            {% endif %}
        </div>
        {% set maxStiche = tisch.regelEinstellung('ohne_neuner') ? 10 : 12 %}
        <div class="text-tisch-300 text-xs">Stich {{ spiel ? spiel.aktuellerStichNr : 0 }}/{{ maxStiche }}</div>
        {% if spiel and mercureTopic %}
        <button type="button"
                data-spieltisch-target="soundToggle"
                data-action="click->spieltisch#soundUmschalten"
                class="text-lg leading-none transition-opacity"
                title="Sound an/aus">🔊</button>
        {% endif %}
    </div>

    {# ── Spielzustand (Tisch-Kulisse, via Mercure aktualisiert) ──────── #}
    <div data-spieltisch-target="zustand" class="flex-1 flex flex-col">
        {% include 'spieltisch/_tisch_bereich.html.twig' %}
    </div>

    {# ── Persistente Overlay-Dialoge ─────────────────────────────────────
       Liegen bewusst AUSSERHALB des #zustand-Containers, damit der innerHTML-
       Austausch beim nächsten Mercure-Event sie nicht zerstört. Der spieltisch-
       Controller spiegelt nur ihren Inhalt (#…Inhalt) und öffnet/schließt sie. #}

    {# Abrechnung des letzten Spiels #}
    <dialog data-spieltisch-target="abrechnungDialog"
            data-action="click->spieltisch#abrechnungBackdrop"
            class="dialog backdrop:bg-black/60 bg-transparent p-0 border-0 w-[92vw] max-w-md">
        <div class="bg-tisch-800 rounded-2xl border border-tisch-600 shadow-2xl p-5 text-left">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-bold text-white">Abrechnung</h2>
                <button type="button" class="text-tisch-300 hover:text-white text-2xl leading-none"
                        data-action="spieltisch#abrechnungSchliessen" aria-label="Schließen">&times;</button>
            </div>
            <div data-spieltisch-target="abrechnungInhalt">
                {% include 'spieltisch/_abrechnung_inhalt.html.twig' %}
            </div>
        </div>
    </dialog>

    {# Vorbehaltsrunde — Pflichtphase: kein Schließen per ESC/Backdrop #}
    <dialog data-spieltisch-target="vorbehaltDialog"
            data-action="cancel->spieltisch#dialogSchliessenVerhindern"
            class="dialog backdrop:bg-black/60 bg-transparent p-0 border-0 w-[92vw] max-w-md">
        <div class="bg-tisch-800 rounded-2xl border border-tisch-600 shadow-2xl p-5 text-left">
            <div class="mb-4 text-center">
                <h2 class="text-lg font-bold text-white">Vorbehaltsrunde</h2>
                <p class="text-tisch-300 text-xs mt-1">Jeder Spieler deklariert reihum seinen Vorbehalt.</p>
            </div>
            <div data-spieltisch-target="vorbehaltInhalt">
                {% if phase == 'VORBEHALT' %}{% include 'spieltisch/_vorbehalt_inhalt.html.twig' %}{% endif %}
            </div>
        </div>
    </dialog>

    {# ── Tisch-Einstellungen (nur für aktive Spieler, unterhalb des Spielfelds) #}
    {% set meinTischSpieler = null %}
    {% for ts in tisch.aktiveSpieler %}
        {% if ts.user and ts.user.id == app.user.id %}
            {% set meinTischSpieler = ts %}
        {% endif %}
    {% endfor %}
    {% include 'spieltisch/_tisch_einstellungen.html.twig' with {
        tisch: tisch,
        spiel: spiel,
        istAktiverSpieler: meinTischSpieler is not null,
        meinTischSpieler: meinTischSpieler,
    } %}

    {# ── Tisch-Chat ──────────────────────────────────────────────────── #}
    {% if meinTischSpieler is not null %}
        {% include 'spieltisch/_chat.html.twig' %}
    {% endif %}

</div>
{% endblock %}
