{# Dynamischer Inhalt des Vorbehalts-Dialogs (in #vorbehaltInhalt injiziert).
   Die Dialog-Hülle (header) liegt persistent in index.html.twig.
   Wichtig: Deklarations-Buttons und Kartenvorschau müssen im selben
   vorbehalt-vorschau-Controller liegen (Vorschau sortiert die Karten um). #}
{% set meinSitzplatz = teilnehmer ? teilnehmer.sitzplatz : 0 %}
{% set ichBinDran = spiel.aktuellerSpielerSitzplatz == meinSitzplatz %}

<div class="flex flex-col items-center gap-5"
     data-controller="vorbehalt-vorschau"
     data-vorbehalt-vorschau-sortierungen-value="{{ (vorbehaltSortierungen ?? {})|json_encode }}"
     data-vorbehalt-vorschau-action-url-value="{{ path('app_vorbehalt', {id: tisch.id}) }}"
     data-vorbehalt-vorschau-csrf-value="{{ csrf_token('vorbehalt_' ~ tisch.id) }}">

    {# Status der Deklarationen #}
    <div class="flex gap-4">
        {% for t in spiel.teilnehmer|sort((a, b) => a.sitzplatz <=> b.sitzplatz) %}
            <div class="text-center">
                <div class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold
                    {% if t.vorbehaltDeklariert %}bg-green-600 text-white{% elseif spiel.aktuellerSpielerSitzplatz == t.sitzplatz %}bg-yellow-400 text-black animate-pulse{% else %}bg-tisch-700 text-tisch-400{% endif %}">
                    {{ t.vorbehaltDeklariert ? '✓' : (spiel.aktuellerSpielerSitzplatz == t.sitzplatz ? '?' : '…') }}
                </div>
                <p class="text-xs text-tisch-300 mt-1 truncate max-w-16">{{ t.anzeigeName }}</p>
                {% if t.vorbehaltDeklariert and t.sitzplatz == meinSitzplatz %}
                    <p class="text-xs text-green-400 mt-0.5">{{ t.vorbehaltTyp ? t.vorbehaltTyp.value : '' }}</p>
                {% endif %}
            </div>
        {% endfor %}
    </div>

    {# Eigene Deklaration — nur wenn ich an der Reihe #}
    {% if ichBinDran and teilnehmer and not teilnehmer.vorbehaltDeklariert %}
        <div class="bg-tisch-900/60 rounded-xl p-5 border border-tisch-600 w-full">
            <p class="text-white text-sm font-medium mb-3 text-center">Du bist an der Reihe:</p>
            <div class="flex flex-col gap-2">
                {# GESUND — sofort absenden #}
                {% if 'GESUND' in vorbehaltOptionen|map(o => o.value) %}
                    <form method="post" action="{{ path('app_vorbehalt', {id: tisch.id}) }}"
                          data-action="submit->spieltisch#vorbehalt">
                        <input type="hidden" name="_token" value="{{ csrf_token('vorbehalt_' ~ tisch.id) }}">
                        <input type="hidden" name="vorbehalt_typ" value="GESUND">
                        <button type="submit" class="w-full py-2 rounded-lg bg-tisch-600 hover:bg-tisch-500 text-white text-sm font-medium">
                            Gesund (kein Vorbehalt)
                        </button>
                    </form>
                {% endif %}

                {# HOCHZEIT — Vorschau #}
                {% if 'HOCHZEIT' in vorbehaltOptionen|map(o => o.value) %}
                    <button type="button" class="w-full py-2 rounded-lg bg-purple-700 hover:bg-purple-600 text-white text-sm font-medium"
                            data-action="click->vorbehalt-vorschau#vorschau"
                            data-vorbehalt-vorschau-typ-param="HOCHZEIT">
                        Hochzeit ♛♛
                    </button>
                {% endif %}

                {# ARMUT — Vorschau #}
                {% if 'ARMUT' in vorbehaltOptionen|map(o => o.value) %}
                    <button type="button" class="w-full py-2 rounded-lg bg-orange-700 hover:bg-orange-600 text-white text-sm font-medium"
                            data-action="click->vorbehalt-vorschau#vorschau"
                            data-vorbehalt-vorschau-typ-param="ARMUT">
                        Armut (≤ 3 Trümpfe)
                    </button>
                {% endif %}

                {# SOLO — Variantenauswahl als Vorschau #}
                {% if 'SOLO' in vorbehaltOptionen|map(o => o.value) %}
                    <details class="rounded-lg bg-yellow-900 border border-yellow-700">
                        <summary class="w-full py-2 px-4 text-yellow-300 text-sm font-medium cursor-pointer">
                            Solo spielen ▼
                        </summary>
                        <div class="p-3 grid grid-cols-2 gap-2">
                            {% set soloVarianten = ['SOLO_BUBEN', 'SOLO_DAMEN', 'SOLO_FLEISCHLOS', 'SOLO_KARO', 'SOLO_HERZ', 'SOLO_PIK', 'SOLO_KREUZ'] %}
                            {% set regelwerk = tisch.regelEinstellungen %}
                            {% for variante in soloVarianten %}
                                {% if variante in (regelwerk.soli_erlaubt ?? soloVarianten) %}
                                    <button type="button" class="w-full py-1.5 rounded bg-yellow-700 hover:bg-yellow-600 text-yellow-100 text-xs font-medium"
                                            data-action="click->vorbehalt-vorschau#vorschau"
                                            data-vorbehalt-vorschau-typ-param="SOLO"
                                            data-vorbehalt-vorschau-variante-param="{{ variante }}">
                                        {{ variante|replace({'SOLO_': '', '_': '-'}) }}
                                    </button>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </details>
                {% endif %}
            </div>

            {# Bestätigungs-Bereich (versteckt bis Vorschau aktiv) #}
            <div data-vorbehalt-vorschau-target="bestaetigung" class="hidden mt-4 pt-4 border-t border-tisch-600">
                <p class="text-tisch-300 text-xs text-center mb-2">
                    Vorschau: <strong data-vorbehalt-vorschau-target="vorschauLabel" class="text-white"></strong>
                </p>
                <div class="flex gap-2">
                    <button type="button" class="flex-1 py-2 rounded-lg bg-green-700 hover:bg-green-600 text-white text-sm font-bold"
                            data-action="click->vorbehalt-vorschau#bestaetigen">
                        Bestätigen
                    </button>
                    <button type="button" class="flex-1 py-2 rounded-lg bg-gray-700 hover:bg-gray-600 text-gray-300 text-sm font-medium"
                            data-action="click->vorbehalt-vorschau#abbrechen">
                        Abbrechen
                    </button>
                </div>
            </div>
        </div>
    {% elseif teilnehmer and teilnehmer.vorbehaltDeklariert %}
        <div class="bg-green-900 border border-green-700 rounded-lg px-6 py-3 text-green-300 text-sm text-center">
            Du hast <strong>{{ teilnehmer.vorbehaltTyp ? teilnehmer.vorbehaltTyp.value : '' }}</strong> deklariert.
            Warte auf die anderen Spieler…
        </div>
    {% else %}
        <div class="text-tisch-400 text-sm text-center">
            Warte auf Sitzplatz {{ spiel.aktuellerSpielerSitzplatz }}…
        </div>
    {% endif %}

    {# Karten-Vorschau (nicht spielbar in Vorbehaltsrunde) #}
    {% if hand is not empty %}
        <div class="flex flex-wrap gap-2 justify-center opacity-90" data-vorbehalt-vorschau-target="kartenContainer">
            {% for karte in hand %}
                <div class="spielkarte spielkarte--mittel" data-karte-id="{{ karte.id() }}">
                    {{ karten_svg(karte) }}
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
