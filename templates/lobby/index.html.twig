{% extends 'base.html.twig' %}

{% block title %}Lobby – Doppelkopf Online{% endblock %}

{% block body %}
<div class="flex flex-col lg:flex-row gap-8">

    {# ── Tisch erstellen ────────────────────────────────────────────────── #}
    <aside class="lg:w-72 shrink-0">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h2 class="text-base font-semibold text-gray-900 mb-4">Neuen Tisch erstellen</h2>
            {{ form_start(erstellenForm, {attr: {class: 'space-y-4'}}) }}
                <div>
                    {{ form_label(erstellenForm.name, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(erstellenForm.name, {attr: {class: 'w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-tisch-500 focus:border-tisch-500'}}) }}
                    {{ form_errors(erstellenForm.name) }}
                </div>
                <div>
                    {{ form_label(erstellenForm.zugangsmodus, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(erstellenForm.zugangsmodus, {attr: {class: 'w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-tisch-500 focus:border-tisch-500'}}) }}
                    {{ form_errors(erstellenForm.zugangsmodus) }}
                </div>
                <button type="submit" class="btn-primary w-full text-sm">
                    Tisch erstellen
                </button>
            {{ form_end(erstellenForm) }}
        </div>
    </aside>

    {# ── Tischliste (live via Mercure) ──────────────────────────────────── #}
    <section class="flex-1 min-w-0">
        <h1 class="text-2xl font-bold text-gray-900 mb-6">Spiellobby</h1>

        <div data-controller="lobby"
             data-lobby-mercure-url-value="{{ mercurePublicUrl }}"
             data-lobby-topic-value="{{ mercureTopic }}"
             data-lobby-partial-url-value="{{ path('app_lobby_tischliste') }}">
            {% include 'lobby/_tischliste.html.twig' %}
        </div>
    </section>

</div>
{% endblock %}
