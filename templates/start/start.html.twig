{% extends 'base.html.twig' %}

{% block title %}Doppelkopf Online – Kostenlos im Browser spielen{% endblock %}

{% block body %}
<div class="text-center py-16">
    <h1 class="text-4xl font-bold text-gray-900 dark:text-gray-50 mb-4">Doppelkopf Online</h1>
    <p class="text-xl text-gray-500 dark:text-gray-400 mb-10 max-w-2xl mx-auto">
        Das klassische deutsche Kartenspiel – kostenlos, ohne Werbung, direkt im Browser. Spiele gegen Freunde oder Bots.
    </p>
    <div class="flex justify-center gap-4">
        <a href="{{ path('app_registrieren') }}" class="btn-primary px-8 py-3 text-base">
            Jetzt kostenlos spielen
        </a>
        <a href="{{ path('app_regeln') }}" class="btn-secondary px-8 py-3 text-base">
            Regeln lesen
        </a>
    </div>

    {# Feature-Übersicht #}
    <div class="mt-20 grid grid-cols-1 sm:grid-cols-3 gap-8 max-w-3xl mx-auto text-left">
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 shadow-sm">
            <div class="text-3xl mb-3">🃏</div>
            <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-1">Vollständige Regeln</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400">DDV-Regelwerk mit Soli, Ansagen, Schweinchen und mehr.</p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 shadow-sm">
            <div class="text-3xl mb-3">🤖</div>
            <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-1">Bot-Gegner</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400">Jederzeit spielbereit – auch ohne menschliche Mitspieler.</p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 shadow-sm">
            <div class="text-3xl mb-3">🔒</div>
            <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-1">Privat & kostenlos</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400">Keine Werbung, kein Tracking, kostenlos für alle.</p>
        </div>
    </div>
</div>
{% endblock %}
