{% extends 'base.html.twig' %}

{% block title %}Doppelkopf Online – Kostenlos im Browser spielen{% endblock %}

{% block body %}
<div class="text-center py-16">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Doppelkopf Online</h1>
    <p class="text-xl text-gray-500 mb-10 max-w-2xl mx-auto">
        Das klassische deutsche Kartenspiel – kostenlos, ohne Werbung, direkt im Browser. Spiele gegen Freunde oder Bots.
    </p>
    <div class="flex justify-center gap-4">
        <a href="{{ path('app_registrieren') }}" class="btn-primary px-8 py-3 text-base">
            Jetzt kostenlos spielen
        </a>
        <a href="{{ path('app_regeln') }}" class="btn-secondary px-8 py-3 text-base">
            Regeln lesen
        </a>
    </div>
</div>
{% endblock %}
