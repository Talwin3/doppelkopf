<!DOCTYPE html>
<html lang="de" class="h-full bg-gray-50 dark:bg-gray-950">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Doppelkopf Online{% endblock %}</title>
    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">

    {# FOUC-Prävention: Theme sofort vor erstem Render setzen #}
    <script>
    (function(){
        var t=localStorage.getItem('dk_theme')||'system';
        var d=document.documentElement;
        var isDark=t==='dunkel'||(t==='system'&&window.matchMedia('(prefers-color-scheme:dark)').matches);
        if(isDark){d.classList.add('dark');}
        d.style.colorScheme=isDark?'dark':'light';
    })();
    </script>

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {# Dark-Mode-Override: @tailwindcss/forms setzt .form-input background in @layer utilities,
       was alle components-Layer-Overrides schlägt. Inline-Style umgeht die PostCSS-Pipeline. #}
    <style>
    html{color-scheme:light}
    html.dark{color-scheme:dark}
    .dark .form-input,.dark select:not([multiple]),.dark textarea{
        background-color:oklch(27.8% .033 256.848);
        border-color:oklch(44.6% .043 257.281);
        color:oklch(92.8% .006 264.531)
    }
    .dark .form-input::placeholder,.dark textarea::placeholder{
        color:oklch(55.1% .027 264.364)
    }
    .dark .form-input:focus,.dark select:focus,.dark textarea:focus{
        border-color:oklch(76.6% .209 152.579);
        --tw-ring-color:oklch(76.6% .209 152.579)
    }
    </style>

    {% block head_extra %}{% endblock %}

    {# FrankenPHP Hot-Reload (nur in Entwicklung aktiv) #}
    {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}
</head>
<body class="h-full text-gray-900 dark:text-gray-100">

{# Navigation #}
<nav class="bg-tisch-800 shadow-lg" data-controller="theme">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">

            {# ── Logo + Hauptnavigation ── #}
            <div class="flex items-center gap-6">
                <a href="{{ path('app_start') }}" class="flex items-center gap-2.5 group">
                    {# SVG-Logo: zwei überlappende Spielkarten #}
                    <svg viewBox="0 0 44 30" fill="none" xmlns="http://www.w3.org/2000/svg"
                         class="w-10 h-[1.6rem] shrink-0 transition-transform group-hover:scale-105"
                         aria-hidden="true">
                        <rect x="0.75" y="3" width="24" height="26" rx="4" fill="#14532d" stroke="#4ade80" stroke-width="1.5"/>
                        <text x="12.75" y="22" font-family="Georgia,serif" font-size="14" fill="#86efac" text-anchor="middle">♣</text>
                        <rect x="19.25" y="1" width="24" height="26" rx="4" fill="#15803d" stroke="#4ade80" stroke-width="1.5"/>
                        <text x="31.25" y="20" font-family="Georgia,serif" font-size="15" fill="#fca5a5" text-anchor="middle">♥</text>
                    </svg>
                    <span class="text-white font-bold text-lg tracking-tight leading-none">
                        Doppelkopf<span class="text-tisch-300 font-normal"> Online</span>
                    </span>
                </a>
                {% if app.user %}
                    <a href="{{ path('app_lobby') }}" class="text-tisch-100 hover:text-white text-sm font-medium transition-colors">
                        Lobby
                    </a>
                    <a href="{{ path('app_bestenlisten') }}" class="text-tisch-100 hover:text-white text-sm font-medium transition-colors">
                        Bestenlisten
                    </a>
                    <a href="{{ path('app_replay_liste') }}" class="text-tisch-100 hover:text-white text-sm font-medium transition-colors">
                        Replays
                    </a>
                {% endif %}
            </div>

            {# ── Rechte Seite: User-Menü + Theme-Toggle ── #}
            <div class="flex items-center gap-4">
                {# Theme-Toggle: System → Hell → Dunkel → System #}
                <button data-action="click->theme#umschalten"
                        data-theme-target="icon"
                        class="text-tisch-200 hover:text-white text-base leading-none transition-colors p-1 rounded"
                        title="Erscheinungsbild wechseln">🌐</button>

                {% if app.user %}
                    <a href="{{ path('app_profil', {username: app.user.username}) }}"
                       class="flex items-center gap-2 text-tisch-100 hover:text-white text-sm font-medium transition-colors">
                        <img src="{{ avatar_url(app.user, 48) }}" alt=""
                             class="w-7 h-7 rounded-full bg-tisch-700 ring-1 ring-tisch-600">
                        {{ app.user.username }}
                    </a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin') }}"
                           class="text-yellow-300 hover:text-yellow-100 text-sm font-medium transition-colors">
                            Admin
                        </a>
                    {% endif %}
                    <a href="{{ path('app_logout') }}"
                       class="text-tisch-100 hover:text-white text-sm font-medium transition-colors">
                        Abmelden
                    </a>
                {% else %}
                    <a href="{{ path('app_login') }}"
                       class="text-tisch-100 hover:text-white text-sm font-medium transition-colors">
                        Anmelden
                    </a>
                    <a href="{{ path('app_registrieren') }}" class="btn-primary text-xs">
                        Registrieren
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</nav>

{# Flash-Nachrichten als Toasts #}
{% set flashNachrichten = [] %}
{% for typ, nachrichten in app.flashes %}
    {% for nachricht in nachrichten %}
        {% set flashNachrichten = flashNachrichten|merge([{typ: typ, text: nachricht}]) %}
    {% endfor %}
{% endfor %}
{% if flashNachrichten is not empty %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    var flashes = {{ flashNachrichten|json_encode|raw }};
    var toast = window.__toast;
    if (!toast) return;
    flashes.forEach(function(f) {
        toast(f.text, f.typ === 'success' ? 'success' : 'error');
    });
});
</script>
{% endif %}

{# Toast-Container für globale Benachrichtigungen #}
<div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

{# Seiteninhalt #}
<main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    {% block body %}{% endblock %}
</main>

{# Footer #}
<footer class="mt-auto border-t border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between text-sm text-gray-500 dark:text-gray-400">
        <p>&copy; {{ "now"|date("Y") }} Doppelkopf Online. Kostenlos und werbefrei.</p>
        <div class="flex space-x-6 mt-2 sm:mt-0">
            <a href="{{ path('app_regeln') }}" class="hover:text-gray-700 dark:hover:text-gray-200">Regeln</a>
            <a href="{{ path('app_impressum') }}" class="hover:text-gray-700 dark:hover:text-gray-200">Impressum</a>
            <a href="{{ path('app_datenschutz') }}" class="hover:text-gray-700 dark:hover:text-gray-200">Datenschutz</a>
        </div>
    </div>
</footer>

{% block javascripts %}
    {{ encore_entry_script_tags('app') }}
{% endblock %}

</body>
</html>
