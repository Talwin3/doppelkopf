{% extends 'base.html.twig' %}

{% block title %}Einstellungen – Doppelkopf Online{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto space-y-6">

    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Einstellungen</h1>

    {# ── Benutzername ──────────────────────────────────────────────────── #}
    <section class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
        <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-1">Benutzername</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
            Aktuell: <strong class="text-gray-700 dark:text-gray-300">{{ user.username }}</strong>
            {% if cooldownBis %}
                &middot; <span class="text-orange-600 dark:text-orange-400 text-xs">
                    Nächste Änderung möglich ab {{ cooldownBis|date('d.m.Y') }}
                </span>
            {% else %}
                &middot; <span class="text-gray-400 dark:text-gray-500 text-xs">max. 1× alle 7 Tage</span>
            {% endif %}
        </p>

        {{ form_start(benutzernameForm, {action: path('app_profil_benutzername'), attr: {class: 'flex gap-3'}}) }}
            <div class="flex-1">
                {{ form_widget(benutzernameForm.username, {attr: {
                    class: 'form-input',
                    placeholder: 'Neuer Benutzername',
                    disabled: cooldownBis is not null
                }}) }}
                {{ form_errors(benutzernameForm.username) }}
            </div>
            <button type="submit" class="btn-primary shrink-0" {{ cooldownBis ? 'disabled' : '' }}>
                Ändern
            </button>
        {{ form_end(benutzernameForm) }}
    </section>

    {# ── Passwort ──────────────────────────────────────────────────────── #}
    <section class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
        <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-4">Passwort ändern</h2>

        {{ form_start(passwortForm, {action: path('app_profil_passwort'), attr: {class: 'space-y-4'}}) }}
            <div>
                {{ form_label(passwortForm.aktuellesPasswort, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(passwortForm.aktuellesPasswort, {attr: {class: 'form-input', autocomplete: 'current-password'}}) }}
                {{ form_errors(passwortForm.aktuellesPasswort) }}
            </div>
            <div>
                {{ form_label(passwortForm.neuesPasswort.first, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(passwortForm.neuesPasswort.first, {attr: {class: 'form-input', autocomplete: 'new-password'}}) }}
                {{ form_errors(passwortForm.neuesPasswort.first) }}
            </div>
            <div>
                {{ form_label(passwortForm.neuesPasswort.second, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(passwortForm.neuesPasswort.second, {attr: {class: 'form-input', autocomplete: 'new-password'}}) }}
                {{ form_errors(passwortForm.neuesPasswort.second) }}
            </div>
            <button type="submit" class="btn-primary">Passwort ändern</button>
        {{ form_end(passwortForm) }}
    </section>

    {# ── E-Mail-Adresse ────────────────────────────────────────────────── #}
    <section class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
        <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-1">E-Mail-Adresse</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
            Aktuell: <strong class="text-gray-700 dark:text-gray-300">{{ user.email }}</strong>
            &middot; <span class="text-gray-400 dark:text-gray-500 text-xs">Niemals öffentlich sichtbar</span>
        </p>

        {{ form_start(emailForm, {action: path('app_profil_email'), attr: {class: 'space-y-4'}}) }}
            <div>
                {{ form_label(emailForm.email, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(emailForm.email, {attr: {class: 'form-input', autocomplete: 'email'}}) }}
                {{ form_errors(emailForm.email) }}
            </div>
            <div>
                {{ form_label(emailForm.passwort, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(emailForm.passwort, {attr: {class: 'form-input', autocomplete: 'current-password'}}) }}
                {{ form_errors(emailForm.passwort) }}
            </div>
            <button type="submit" class="btn-primary">E-Mail ändern</button>
        {{ form_end(emailForm) }}
    </section>

    {# ── Datenschutz ───────────────────────────────────────────────────── #}
    <section class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
        <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-4">Datenschutz</h2>

        <form method="post" action="{{ path('app_profil_datenschutz') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('datenschutz') }}">
            <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" name="profil_oeffentlich" value="1"
                       {{ user.profilOeffentlich ? 'checked' : '' }}
                       class="mt-0.5 rounded border-gray-300 dark:border-gray-600 text-tisch-600 dark:bg-gray-700">
                <div>
                    <span class="text-sm font-medium text-gray-900 dark:text-gray-100">Profil öffentlich sichtbar</span>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                        Andere Spieler können dein Profil und deine Statistiken sehen.
                        Bei Deaktivierung ist dein Profil nur für dich selbst sichtbar.
                    </p>
                </div>
            </label>
            <button type="submit" class="btn-primary mt-4">Speichern</button>
        </form>
    </section>

    {# ── Avatar ───────────────────────────────────────────────────────── #}
    <section class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm p-6"
             data-controller="avatar-auswahl"
             data-avatar-auswahl-seed-value="{{ user.avatarSeed }}">
        <div class="flex items-start gap-4 mb-4">
            <img src="{{ avatar_url(user, 96) }}" alt="Dein Avatar"
                 data-avatar-auswahl-target="bigPreview"
                 class="w-20 h-20 rounded-full bg-gray-100 dark:bg-gray-700 ring-2 ring-gray-200 dark:ring-gray-600 shrink-0">
            <div class="flex-1">
                <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-1">Avatar</h2>
                <p class="text-xs text-gray-500 dark:text-gray-400">
                    Wähle einen Stil und würfle so lange, bis dir ein Vorschlag gefällt.
                    Die Auswahl wird erst mit „Speichern“ übernommen.
                </p>
                <button type="button" class="btn-secondary text-xs mt-2"
                        data-action="avatar-auswahl#wuerfeln">🎲 Neu würfeln</button>
            </div>
        </div>

        <form method="post" action="{{ path('app_profil_avatar') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('avatar') }}">
            <input type="hidden" name="avatar_seed" value="{{ user.avatarSeed }}"
                   data-avatar-auswahl-target="seedInput">
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                {% for stil in avatarStile %}
                    {% set aktiv = user.avatarStil.value == stil.value %}
                    <label class="flex flex-col items-center gap-2 cursor-pointer rounded-xl border p-3 transition-colors
                                  {{ aktiv
                                     ? 'border-tisch-500 bg-tisch-50 dark:bg-tisch-900/20'
                                     : 'border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/40' }}">
                        <input type="radio" name="avatar_stil" value="{{ stil.value }}" {{ aktiv ? 'checked' : '' }}
                               data-avatar-auswahl-target="radio"
                               data-action="avatar-auswahl#waehleStil"
                               class="sr-only peer">
                        <img src="{{ avatar_url_roh(stil.value, user.avatarSeed, 96) }}" alt="{{ stil.label }}"
                             data-avatar-auswahl-target="thumb"
                             data-stil="{{ stil.value }}"
                             data-url-template="{{ avatar_url_roh(stil.value, '__SEED__', 96) }}"
                             class="w-16 h-16 rounded-full bg-gray-100 dark:bg-gray-700 peer-checked:ring-2 peer-checked:ring-tisch-500">
                        <span class="text-xs font-medium text-center text-gray-700 dark:text-gray-300 leading-tight">{{ stil.label }}</span>
                    </label>
                {% endfor %}
            </div>
            <p class="text-[11px] text-gray-400 dark:text-gray-500 mt-3">
                Lizenzen: CC0 (Public Domain) sowie „Avataaars"/„Bottts" von Pablo Stanley
                (frei für privat &amp; kommerziell) – siehe <a href="{{ path('app_impressum') }}" class="underline">Impressum</a>.
            </p>
            <button type="submit" class="btn-primary mt-4">Speichern</button>
        </form>
    </section>

    {# ── Kartendeck ───────────────────────────────────────────────────── #}
    <section class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
        <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-1">Kartendeck</h2>
        <p class="text-xs text-gray-500 dark:text-gray-400 mb-4">Wähle das Design der Spielkarten (französisches Blatt).</p>

        <form method="post" action="{{ path('app_profil_kartendeck') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('kartendeck') }}">
            <div class="space-y-3">
                {% for deck in kartendecks %}
                    {% set aktiv = user.kartendeck.value == deck.value %}
                    <label class="flex items-center gap-4 cursor-pointer rounded-xl border p-3 transition-colors
                                  {{ aktiv
                                     ? 'border-tisch-500 bg-tisch-50 dark:bg-tisch-900/20'
                                     : 'border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/40' }}">
                        <input type="radio" name="kartendeck" value="{{ deck.value }}" {{ aktiv ? 'checked' : '' }}
                               class="text-tisch-600 border-gray-300 dark:border-gray-600 dark:bg-gray-700">
                        <span class="text-sm font-medium text-gray-900 dark:text-gray-100 w-44 shrink-0">{{ deck.label }}</span>
                        <div class="ml-auto">{{ karten_deck_vorschau(deck.value) }}</div>
                    </label>
                {% endfor %}
            </div>
            <button type="submit" class="btn-primary mt-4">Speichern</button>
        </form>
    </section>

    {# ── Meine Daten (DSGVO Art. 20) ──────────────────────────────────── #}
    <section class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
        <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-1">Meine Daten exportieren</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
            Lade eine Kopie deiner gespeicherten Daten herunter (DSGVO Art. 20).
        </p>
        <a href="{{ path('app_profil_daten_export') }}" class="btn-secondary text-sm">
            Daten als JSON herunterladen
        </a>
    </section>

    {# ── Konto löschen (DSGVO Art. 17) ────────────────────────────────── #}
    <section class="bg-white dark:bg-gray-800 rounded-2xl border border-red-200 dark:border-red-900 shadow-sm p-6">
        <h2 class="text-base font-semibold text-red-700 dark:text-red-400 mb-1">Konto löschen</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
            Deine personenbezogenen Daten werden unwiderruflich gelöscht (DSGVO Art. 17).
            Deine Spiel-Historie bleibt anonymisiert erhalten.
        </p>

        <details class="group">
            <summary class="cursor-pointer text-sm text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 font-medium select-none">
                Konto löschen ▼
            </summary>
            <form method="post" action="{{ path('app_profil_konto_loeschen') }}" class="mt-4 space-y-4"
                  data-controller="confirm"
                  data-action="submit->confirm#abfragen"
                  data-confirm-title-value="Konto löschen?"
                  data-confirm-text-value="Diese Aktion kann nicht rückgängig gemacht werden."
                  data-confirm-bestaetigen-value="Konto löschen"
                  data-confirm-gefahr-value="true">
                <input type="hidden" name="_token" value="{{ csrf_token('konto_loeschen') }}">
                <div>
                    <label class="form-label">
                        Zur Bestätigung deinen Benutzernamen eingeben:
                        <strong class="text-gray-900 dark:text-gray-100">{{ user.username }}</strong>
                    </label>
                    <input type="text" name="bestaetigung"
                           class="form-input mt-1"
                           placeholder="{{ user.username }}"
                           autocomplete="off" required>
                </div>
                <button type="submit"
                        class="inline-flex items-center px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-md hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 transition-colors dark:focus:ring-offset-gray-800">
                    Konto unwiderruflich löschen
                </button>
            </form>
        </details>
    </section>

</div>
{% endblock %}
