{% extends 'base.html.twig' %}

{% block title %}Anmelden – Doppelkopf Online{% endblock %}

{% block body %}
<div class="flex min-h-[60vh] items-center justify-center">
    <div class="w-full max-w-sm">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-50 text-center mb-8">Anmelden</h1>

        {% if fehler %}
            <div class="flash-error mb-4">
                {{ fehler.messageKey|trans(fehler.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" class="space-y-5">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div>
                <label for="email" class="form-label">E-Mail-Adresse</label>
                <input type="email" id="email" name="_username"
                       value="{{ letzteEmail }}"
                       class="form-input" autocomplete="email" required autofocus>
            </div>

            <div>
                <label for="password" class="form-label">Passwort</label>
                <input type="password" id="password" name="_password"
                       class="form-input" autocomplete="current-password" required>
            </div>

            <div class="flex items-center justify-between">
                <label class="flex items-center space-x-2 text-sm text-gray-600 dark:text-gray-400">
                    <input type="checkbox" name="_remember_me"
                           class="rounded border-gray-300 dark:border-gray-600 text-tisch-600 dark:bg-gray-700">
                    <span>Angemeldet bleiben</span>
                </label>
                <a href="{{ path('app_passwort_vergessen') }}"
                   class="text-sm text-tisch-700 dark:text-tisch-400 hover:text-tisch-900 dark:hover:text-tisch-300">
                    Passwort vergessen?
                </a>
            </div>

            <button type="submit" class="btn-primary w-full justify-center py-2.5">
                Anmelden
            </button>
        </form>

        <p class="mt-6 text-center text-sm text-gray-500 dark:text-gray-400">
            Noch kein Konto?
            <a href="{{ path('app_registrieren') }}"
               class="text-tisch-700 dark:text-tisch-400 font-medium hover:text-tisch-900 dark:hover:text-tisch-300">
                Jetzt registrieren
            </a>
        </p>
    </div>
</div>
{% endblock %}
