# Kopiere diese Datei nach .env und passe die Werte an.
# NIEMALS .env mit echten Secrets in Git einchecken!

APP_ENV=dev
APP_SECRET=ChangeMe32CharacterRandomStringHere

# Datenbank
DB_PASSWORD=secret
DATABASE_URL="postgresql://app:${DB_PASSWORD}@db:5432/doppelkopf?serverVersion=16&charset=utf8"

# Mailer (Dev: Mailpit auf localhost:1025)
MAILER_DSN=smtp://localhost:1025

# Mercure (in FrankenPHP integriert)
# Mindestens 32 Zeichen, kryptografisch zufällig!
MERCURE_PUBLISHER_JWT_KEY=ChangeThisPublisherKeyToSomethingSecure
MERCURE_SUBSCRIBER_JWT_KEY=ChangeThisSubscriberKeyToSomethingSecure
MERCURE_URL=http://app/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost/.well-known/mercure

# Bot-Service
BOT_API_TOKEN=ChangeThisBotTokenToSomethingSecure

# Server (Caddy/FrankenPHP)
SERVER_NAME=localhost