{
    skip_install_trust

    frankenphp
}

{$SERVER_NAME:localhost} {
    root * /app/public

    @static {
        path *.css *.js *.ico *.jpg *.jpeg *.png *.svg *.woff *.woff2
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    encode zstd gzip

    mercure {
        publisher_jwt {$MERCURE_PUBLISHER_JWT_KEY} HS256
        subscriber_jwt {$MERCURE_SUBSCRIBER_JWT_KEY} HS256
        anonymous
        cors_origins {$MERCURE_CORS_ORIGINS:*}
    }

    php_server
}

# Interner HTTP-Endpunkt für Docker-Netzwerk (Worker → Mercure)
http://:8080 {
    mercure {
        publisher_jwt {$MERCURE_PUBLISHER_JWT_KEY} HS256
        subscriber_jwt {$MERCURE_SUBSCRIBER_JWT_KEY} HS256
        anonymous
    }
}
