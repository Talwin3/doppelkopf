{
    skip_install_trust

    frankenphp
}

{$SERVER_NAME:localhost} {
    root * /app/public

    @static {
        path *.css *.js *.ico *.jpg *.jpeg *.png *.svg *.woff *.woff2
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    encode zstd gzip

    mercure {
        # Gleicher Name wie beim internen Endpunkt unten => gemeinsamer Transport,
        # d. h. was der Worker dort publiziert, kommt hier bei den Browsern an.
        name doppelkopf
        # Mercure-Protokoll 1.0: Tokens müssen iss = MERCURE_JWT_ISSUER tragen
        issuer {$MERCURE_JWT_ISSUER:doppelkopf} {
            publisher {
                jwt {$MERCURE_PUBLISHER_JWT_KEY} HS256
            }
            subscriber {
                jwt {$MERCURE_SUBSCRIBER_JWT_KEY} HS256
            }
        }
        anonymous
        cors_origins {$MERCURE_CORS_ORIGINS:*}
    }

    php_server
}

# Interner HTTP-Endpunkt für Docker-Netzwerk (Worker → Mercure)
http://:8080 {
    mercure {
        name doppelkopf
        # Mercure-Protokoll 1.0: Tokens müssen iss = MERCURE_JWT_ISSUER tragen
        issuer {$MERCURE_JWT_ISSUER:doppelkopf} {
            publisher {
                jwt {$MERCURE_PUBLISHER_JWT_KEY} HS256
            }
            subscriber {
                jwt {$MERCURE_SUBSCRIBER_JWT_KEY} HS256
            }
        }
        anonymous
    }
}
