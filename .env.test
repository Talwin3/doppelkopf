# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Kein echter SMTP-Versand im Test; die Nachrichten landen nur im Message-Logger,
# über den die Mailer-Assertions sie auslesen.
MAILER_DSN=null://null

# Eigene Test-Datenbank (gleicher Postgres-Container). Doctrine haengt im test-Env
# automatisch das Suffix "_test" an (siehe config/packages/doctrine.yaml) → die
# effektive DB ist "doppelkopf_test". Jeder Test laeuft dank dama/doctrine-test-bundle
# in einer Transaktion, die danach zurueckgerollt wird.
DATABASE_URL="postgresql://app:${DB_PASSWORD}@db:5432/doppelkopf?serverVersion=16&charset=utf8"
